<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/cream">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Стать бобром"
        android:textSize="26sp"
        android:textColor="@color/bark_dark"
        android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"/>
    <EditText android:id="@+id/etNick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Никнейм"
        android:inputType="text"/>
    <EditText android:id="@+id/etPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Пароль"
        android:inputType="textPassword"/>
    <Button android:id="@+id/btnReg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Создать аккаунт"
        android:backgroundTint="@color/leaf_green"
        android:textColor="@color/white"/>
</LinearLayout>
